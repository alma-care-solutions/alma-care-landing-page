# E-mail delivery via Resend (https://resend.com/api-keys). Copy to .env.local locally,
# in production (Coolify) set the same variables in the app's environment.
RESEND_API_KEY=re_xxxxxxxxx
# Where form leads go and who they are sent from. The sender domain must be verified in Resend.
CONTACT_TO=info@alma-care.eu
CONTACT_FROM="Alma <info@alma-care.eu>"

# Public site origin (canonical URL, OG image). Defaults to https://alma-care.eu in production.
NEXT_PUBLIC_SITE_URL=https://alma-care.eu
